# ==========================================================
#  API KEYS
#  Copy this file to .env and fill in your keys.
#  .env is git-ignored, so your keys never reach GitHub.
# ==========================================================

# ----------------------------------------------------------
#  LLM provider: groq (default) or openrouter
#  Both host the same models; only the key and the limits differ.
# ----------------------------------------------------------
LLM_PROVIDER=groq

# ----------------------------------------------------------
#  Groq
#  Used when LLM_PROVIDER=groq: RAG answers, Text-to-SQL, the agent
#  Get one at: https://console.groq.com/keys
# ----------------------------------------------------------
GROQ_API_KEY=

# ----------------------------------------------------------
#  OpenRouter
#  Used when LLM_PROVIDER=openrouter (pay-as-you-go credits;
#  set a low limit on the key, e.g. $5)
#  Get one at: https://openrouter.ai/settings/keys
# ----------------------------------------------------------
OPENROUTER_API_KEY=

# ----------------------------------------------------------
#  Hugging Face
#  Used by: RAG evaluation scripts (scripts/rag/metrics)
#  Get one at: https://huggingface.co/settings/tokens
# ----------------------------------------------------------
HF_TOKEN=

# ----------------------------------------------------------
#  App password (optional)
#  When set, the browser asks for this password (any username)
#  before Rexie loads. Leave empty to run without a login on
#  your own machine; set it before others can reach the server.
# ----------------------------------------------------------
APP_PASSWORD=
