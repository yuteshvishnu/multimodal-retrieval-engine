# Python environment and installed packages
.venv/
venv/
env/

# Python cache
__pycache__/
*.pyc

# Secrets (API keys)
.env

# Database files (large; add your own locally)
data/**/*.sqlite
# ...except the small practice database (45 KB)
!data/text_to_sql/retail_store/retail_store.sqlite

# Table embedding index (rebuilt automatically)
data/**/table_embeddings.npz

# React: installed packages and build output
frontend/node_modules/
frontend/dist/

# macOS
.DS_Store

# Scribe answer feedback (contains users' questions)
data/rag/feedback/

# Scout SQL error log (contains users' questions); the known errors file is tracked
data/text_to_sql/logs/

# Dashboard usage (questions asked, LLM calls, costs)
data/usage/
